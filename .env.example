# =====================================================================
# MandaMix — Environment configuration (example)
# Copy to .env and fill in. NEVER commit real secrets. .env is gitignored.
# =====================================================================

# ---------- App ----------
NODE_ENV=development                       # development | staging | production
APP_NAME=MandaMix
API_PORT=8080
API_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000          # used in emails / redirects
LOG_LEVEL=info                             # debug|info|warn|error

# ---------- Localization ----------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,th,vi,ms              # learner-facing languages

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://mandamix:password@localhost:5432/mandamix
DB_POOL_MAX=20
DB_SSL=false                               # true in production

# ---------- Cache / queue (Redis) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth / JWT ----------
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=900                        # seconds (15 min)
REFRESH_TOKEN_TTL=2592000                   # seconds (30 days)
PASSWORD_HASH_ROUNDS=12

# ---------- OAuth (social login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                          # base64-encoded .p8

# ---------- Payments: Stripe (PSP) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx          # safe to expose to client
STRIPE_WEBHOOK_SECRET=whsec_xxx             # verify webhook signatures
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# ---------- Trial & billing policy (feature flags) ----------
TRIAL_DAYS=30
TRIAL_REQUIRE_CARD=true                     # card-required trial (PRD default)
REQUIRE_VERIFICATION=false                  # require email/phone verification before trial (PRD §5.2)
FREE_TIER_ENABLED=true                      # post-trial fallback (open question)
DUNNING_RETRY_GAP_DAYS=1,3,7                # days between dunning retries
DUNNING_MAX_ATTEMPTS=4                       # charges before downgrade
PAST_DUE_GRACE_DAYS=7                        # grace access during dunning before downgrade
DEFAULT_CURRENCY=USD
# Tax: destination-based VAT/GST, tax-inclusive pricing. Home entity = Singapore (9% GST).
DEFAULT_TAX_COUNTRY=SG                       # fallback when billing country is unknown
PRICE_OVERRIDE_FLOOR_PCT=50                  # below this % of list, overrides need finance_admin

# ---------- Email provider ----------
EMAIL_PROVIDER=postmark                     # postmark|sendgrid|ses
EMAIL_API_KEY=
EMAIL_FROM="MandaMix <no-reply@mandamix.com>"
EMAIL_REPLY_TO=support@mandamix.com

# ---------- Push notifications ----------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=                   # base64-encoded service account
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.mandamix.app
APNS_PRIVATE_KEY=                           # base64-encoded .p8

# ---------- Object storage / CDN (Mandarin audio, media) ----------
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=mandamix-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.mandamix.com

# ---------- Speech / pronunciation scoring (P1) ----------
SPEECH_PROVIDER=                            # azure|google|iflytek
SPEECH_API_KEY=
SPEECH_REGION=

# ---------- Analytics ----------
ANALYTICS_PROVIDER=amplitude               # amplitude|mixpanel|posthog
ANALYTICS_WRITE_KEY=

# ---------- Observability ----------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Security ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.mandamix.com
RATE_LIMIT_PER_MINUTE=120
DATA_ENCRYPTION_KEY=replace-32-byte-base64-key   # for encrypting PII at rest
