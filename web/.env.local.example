# Copy to .env.local for local dev. .env.local is gitignored.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://mandamix:mandamix@localhost:5432/mandamix

# Auth — change in production
AUTH_JWT_SECRET=dev-insecure-secret-change-me-please-32chars

# Billing policy
TRIAL_DAYS=30
DEFAULT_CURRENCY=PHP

# PayMongo — leave BLANK to use the built-in mock PSP (no card is really charged).
# Fill these with your live/test keys to switch to the real PayMongo integration.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Protects POST /api/v1/internal/run-billing (the trial-charge / dunning runner).
INTERNAL_BILLING_SECRET=dev-internal-secret
