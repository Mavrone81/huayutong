# Copy to deploy.env (git-ignored) ON THE SERVER and fill in real values.
#   cp deploy/deploy.env.example deploy/deploy.env && edit
#
# These are server-specific facts the deploy script needs. Keeping them here
# (not hard-coded) means the committed script stays generic and safe.

# Absolute path to this git checkout on the server.
REPO_DIR=/opt/mandamix/huayutong

# Branch to track.
BRANCH=main

# The SERVER docker-compose file that defines THIS app's services.
# (If the app compose is web/docker-compose.yml inside the repo, point here:
#  REPO_DIR/web/docker-compose.yml — but confirm it actually defines the app,
#  not just Postgres.)
COMPOSE_FILE=/opt/mandamix/huayutong/web/docker-compose.yml

# Space-separated service name(s) for THIS app ONLY. NEVER leave blank
# (blank would target every service in the compose file). Do NOT include
# unrelated apps' services. Example: "web" or "web worker".
SERVICES="web"

# build  -> compose service uses build: (rebuild from Dockerfile on each deploy)
# pull   -> compose service uses image: from a registry (pull new image, recreate)
BUILD_MODE=build
